---
import Base from '../../layouts/Base.astro';
import CardCasa from '../../components/CardCasa.astro';
import MapaCasas from '../../components/MapaCasas.astro';
import Padrao from '../../components/Padrao.astro';
import { unidades } from '../../config/unidades';
import { jsonldOrg, jsonldRestaurante, breadcrumb } from '../../lib/seo';
---
<Base
  titulo="As 4 casas da Nalu · Cocó, Sul, North e Eusébio"
  descricao="Encontre a Nalu mais perto: Cocó (pioneira, com espaço kids), Sul (delivery e retirada), North (ao ar livre na Bezerra de Menezes) e Eusébio."
  jsonld={[jsonldOrg(), ...unidades.map(jsonldRestaurante), breadcrumb([['Início', '/'], ['Unidades', '/unidades']])]}
>
  <section class="topo-casas on-dark" data-hero>
    <Padrao opacidade={0.08} />
    <div class="wrap in">
      <div>
        <h1 class="chamada">As 4 casas</h1>
        <p>Do Cocó ao Eusébio. Escolha a sua e a gente leva o resto: pedido, rota e horário.</p>
        <button type="button" class="btn" data-abre-seletor>Escolher minha unidade</button>
      </div>
      <div class="mapa" aria-hidden="true"><MapaCasas /></div>
    </div>
  </section>
  <section class="wrap lista" aria-label="Unidades">
    <ul>
      {unidades.map((u) => <li><CardCasa u={u} tom="claro" titulo="h2" /></li>)}
    </ul>
  </section>
</Base>
<style>
  .topo-casas { position: relative; background: var(--petroleo-noite); color: var(--farinha-2); padding-block: 36px 40px; overflow: hidden; }
  .in { position: relative; z-index: 1; display: grid; gap: 20px; align-items: center; }
  .in > div:first-child { display: grid; gap: 14px; justify-items: start; }
  h1 { font-size: var(--t-3xl); color: var(--ambar); }
  .in p { max-width: 38ch; font-size: var(--t-m); }
  .mapa { max-width: 420px; }
  .lista { padding-block: 32px 80px; }
  .lista ul { display: grid; gap: 18px; }
  @media (min-width: 720px) { .lista ul { grid-template-columns: 1fr 1fr; gap: 24px; } }
  @media (min-width: 1024px) {
    .topo-casas { padding-block: 70px; }
    .in { grid-template-columns: 1fr 1fr; }
    .mapa { justify-self: end; width: 100%; max-width: 520px; }
  }
</style>
