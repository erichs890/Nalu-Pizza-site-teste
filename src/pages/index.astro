<script>
  import { naluManiaHoje, agoraFortaleza } from '../lib/horario';
  import { site } from '../config/site';
  const box = document.querySelector<HTMLElement>('[data-mania-hoje]');
  const txt = document.querySelector<HTMLElement>('[data-mania-txt]');
  if (box && txt) {
    const ativo = naluManiaHoje(site.naluMania.dias);
    box.dataset.ativo = String(ativo);
    const dia = agoraFortaleza().dia;
    txt.textContent = ativo ? (dia === 4 ? 'Hoje é o último dia da Nalu Mania na semana' : 'Hoje tem Nalu Mania') : 'Nalu Mania volta segunda';
  }
  // Mapa: destaca o pino da casa em foco/hover na lista
  const sec = document.querySelector<HTMLElement>('[data-mapa-ativo]');
  document.querySelectorAll<HTMLElement>('[data-casa-item]').forEach((li) => {
    const on = () => sec && (sec.dataset.mapaAtivo = li.dataset.casaItem!);
    li.addEventListener('pointerenter', on);
    li.addEventListener('focusin', on);
  });
</script>
