---
// Padrão de traço âmbar com fatias e rodelas de pizza (eco das artes do Instagram).
// Fica atrás do conteúdo de seções escuras. Densidade baixa de propósito.
interface Props { opacidade?: number; cor?: string; id?: string; }
const { opacidade = 0.14, cor = 'var(--ambar)', id = 'p' + Math.random().toString(36).slice(2, 7) } = Astro.props;
---
<svg class="padrao" aria-hidden="true" style={`opacity:${opacidade};color:${cor}`}>
  <defs>
    <pattern id={id} width="220" height="220" patternUnits="userSpaceOnUse" patternTransform="rotate(-8)">
      <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <!-- fatia -->
        <path d="M30 40 L78 52 Q72 82 52 98 Z" />
        <path d="M32 44 Q56 46 76 55" />
        <circle cx="50" cy="62" r="4" /><circle cx="60" cy="78" r="3" />
        <!-- rodela inteira -->
        <circle cx="160" cy="70" r="26" /><circle cx="160" cy="70" r="20" />
        <path d="M160 50v40M140 70h40M146 56l28 28M174 56l-28 28" stroke-width="1.1" />
        <!-- fatia virada -->
        <path d="M150 150 L196 168 Q178 196 154 198 Z" />
        <circle cx="166" cy="174" r="3.5" />
        <!-- folhinhas de manjericão -->
        <path d="M60 160 q10 -14 22 -4 q-10 14 -22 4Z" />
        <path d="M86 186 q8 -12 18 -3 q-8 12 -18 3Z" />
        <circle cx="110" cy="120" r="2.5" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
<style>
  .padrao { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
</style>
