---
// Só no celular. Aparece depois do hero e some quando o rodapé entra.
import Icone from './Icone.astro';
---
<nav class="barra-inferior" aria-label="Atalhos" data-barra>
  <a href="/cardapio"><Icone nome="cardapio" /><span>Cardápio</span></a>
  <a href="/unidades"><Icone nome="casas" /><span>Unidades</span></a>
  <a href="#escolher-unidade" data-u-pedido class="pedir"><Icone nome="sacola" /><span>Pedir</span></a>
  <a href="#escolher-unidade" data-u-whats><Icone nome="whats" /><span>WhatsApp</span></a>
  <button type="button" data-abre-seletor><Icone nome="pin" /><span data-u-nome="Unidade">Unidade</span></button>
</nav>
<style>
  .barra-inferior {
    position: fixed; left: 8px; right: 8px; bottom: calc(8px + env(safe-area-inset-bottom)); z-index: 45;
    display: grid; grid-template-columns: 1fr 1fr 1.25fr 1fr 1fr; align-items: end; gap: 2px;
    padding: 6px; border-radius: 24px;
    background: var(--petroleo-noite); color: var(--farinha-2);
    box-shadow: 0 14px 30px -12px rgba(10, 46, 46, 0.6);
    transform: translateY(calc(100% + 30px)); transition: transform 0.3s var(--ease);
  }
  .barra-inferior.visivel { transform: none; }
  a, button {
    display: grid; justify-items: center; align-content: center; gap: 2px; min-height: 52px; padding: 4px 2px;
    color: inherit; text-decoration: none; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.01em;
    background: transparent; border: 0; border-radius: 16px; cursor: pointer; -webkit-tap-highlight-color: transparent;
  }
  span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .barra-inferior :global(svg) { width: 22px; height: 22px; }
  .pedir { background: var(--ambar); color: var(--petroleo-noite); min-height: 62px; margin-top: -14px; border-radius: 20px; font-size: 0.875rem; font-family: var(--f-display); }
  .pedir :global(svg) { width: 26px; height: 26px; }
  @media (min-width: 1024px) { .barra-inferior { display: none; } }
  @media print { .barra-inferior { display: none; } }
</style>
<script>
  const barra = document.querySelector<HTMLElement>('[data-barra]')!;
  const hero = document.querySelector('[data-hero]');
  const rodape = document.querySelector('footer');
  let heroFora = !hero, rodapeDentro = false;
  const atualizar = () => barra.classList.toggle('visivel', heroFora && !rodapeDentro);
  const io = new IntersectionObserver((es) => {
    for (const e of es) {
      if (e.target === hero) heroFora = !e.isIntersecting;
      if (e.target === rodape) rodapeDentro = e.isIntersecting;
    }
    atualizar();
  }, { rootMargin: '0px 0px -40% 0px' });
  if (hero) io.observe(hero);
  if (rodape) io.observe(rodape);
  atualizar();
</script>
