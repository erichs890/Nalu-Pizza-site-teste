---
import { servicoNome, rotaUrl, telLink, type Unidade } from '../config/unidades';
import Foto from './Foto.astro';
import Icone from './Icone.astro';
interface Props { u: Unidade; tom?: 'claro' | 'escuro'; titulo?: 'h2' | 'h3'; }
const { u, tom = 'escuro', titulo = 'h3' } = Astro.props;
const H = titulo;
const tel = telLink(u);
const fotoPede: Record<string, string> = {
  coco: 'salão do Cocó à noite, plantas e luz quente, mesas com família',
  sul: 'fachada ou balcão de retirada da Nalu Sul',
  north: 'quintal ao ar livre sob coqueiros, cordões de luz acesos',
  eusebio: 'fachada ou salão da casa nova do Eusébio',
};
---
<article class:list={['casa', tom === 'escuro' ? 'on-dark' : '']} data-casa={u.slug}>
  <a href={`/unidades/${u.slug}`} class="foto-link" tabindex="-1" aria-hidden="true">
    <Foto src={`unidades/${u.slug}/ambiente.jpg`} alt="" pede={fotoPede[u.slug]} proporcao="16/10" sizes="(min-width: 1024px) 420px, 92vw" tom={tom === 'escuro' ? 'petroleo' : 'massa'} />
  </a>
  <div class="info">
    <div class="cab">
      <H class="bairro"><a href={`/unidades/${u.slug}`}>{u.nome}</a></H>
      <span class="status" data-status-slug={u.slug}>Horário a confirmar</span>
    </div>
    <p class="end">{u.endereco} · {u.bairro}{u.cidade !== 'Fortaleza' && ` · ${u.cidade}`}</p>
    {u.servicos.length > 0
      ? <p class="servicos">{u.servicos.map((s) => <span class="chip">{servicoNome[s]}</span>)}</p>
      : <p class="servicos"><span class="confirmar">[CONFIRMAR: serviços]</span></p>}
    <div class="acoes">
      <a class="btn btn--pequeno btn--contorno" href={rotaUrl(u)} target="_blank" rel="noopener"><Icone nome="rota" />Rota</a>
      {u.pedido
        ? <a class="btn btn--pequeno" href={u.pedido} target="_blank" rel="noopener"><Icone nome="sacola" />Pedir</a>
        : <span class="btn btn--pequeno desativado" aria-disabled="true">Pedido em breve</span>}
      {tel
        ? <a class="btn btn--pequeno btn--contorno" href={tel}><Icone nome="fone" />Ligar</a>
        : <span class="btn btn--pequeno btn--contorno desativado" aria-disabled="true" title="Telefone a confirmar"><Icone nome="fone" />Ligar</span>}
    </div>
  </div>
</article>
<style>
  .casa { display: grid; border-radius: var(--r-card); overflow: hidden; background: var(--petroleo); color: var(--farinha-2); }
  .casa:not(.on-dark) { background: var(--farinha-2); color: var(--tinta); }
  .foto-link { display: block; overflow: hidden; }
  .foto-link :global(.foto) { transition: transform 0.6s var(--ease); }
  @media (hover: hover) { .casa:hover .foto-link :global(.foto) { transform: scale(1.04); } }
  .info { padding: 18px 18px 20px; display: grid; gap: 10px; }
  .cab { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .bairro { font-family: var(--f-display); font-size: 2rem; font-weight: 600; line-height: 1; }
  .bairro a { text-decoration: none; }
  .on-dark .bairro { color: var(--ambar); }
  .casa:not(.on-dark) .bairro { color: var(--petroleo); }
  .end { font-size: 0.9375rem; opacity: 0.9; }
  .servicos { display: flex; flex-wrap: wrap; gap: 6px; }
  .acoes { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-top: 4px; }
  .acoes .btn { padding: 0 8px; font-size: 0.9375rem; gap: 0.35em; }
  .desativado { opacity: 0.45; cursor: not-allowed; font-size: 0.8125rem !important; text-align: center; line-height: 1.1; }
  .on-dark .confirmar { color: var(--petroleo-noite); }
</style>
